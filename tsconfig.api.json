{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node", "@vercel/node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "api",
    "vite.config.ts",
    "src/application/meal-option/**/*.ts",
    "src/application/planner/**/*.ts",
    "src/application/shared/**/*.ts",
    "src/application/catalog/**/*.ts",
    "src/domain/calculation/**/*.ts",
    "src/domain/catalog/**/*.ts",
    "src/domain/household/**/*.ts",
    "src/domain/meal-option/**/*.ts",
    "src/domain/nutrition/**/*.ts",
    "src/domain/planner/**/*.ts",
    "src/domain/portion/**/*.ts",
    "src/domain/pricing/**/*.ts",
    "src/domain/recipe/**/*.ts",
    "src/domain/shared/**/*.ts",
    "src/domain/shopping/**/*.ts",
    "src/infrastructure/server/**/*.ts",
    "src/infrastructure/supabase/server-auth.ts",
    "src/infrastructure/supabase/server-admin-auth.ts",
    "src/infrastructure/supabase/browser-client.ts",
    "src/infrastructure/supabase/database.types.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
